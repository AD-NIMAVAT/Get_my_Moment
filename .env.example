# Root environment configuration template for Get My Moment

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-xyz123
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database & Vector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/getmymoment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=getmymoment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["jpg","jpeg","png","webp"]

# Face Debug Crops (Disabled by default for privacy)
FACE_DEBUG_CROPS_ENABLED=false

# AI & Face Matching
AI_DETECTION_MODEL=yunet
AI_RECOGNITION_MODEL=sface
AI_DEVICE=cpu
AI_COSINE_SIMILARITY_THRESHOLD=0.65

# Guest OTP Provider (development / mock mode)
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300

# Web / Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
